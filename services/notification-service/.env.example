# Server
PORT=5009

# MongoDB (separate database from the other services)
MONGO_URI=mongodb://127.0.0.1:27017/campusync_notifications

# JWT - MUST match the JWT_SECRET used by every other service and the gateway
JWT_SECRET=replace_with_a_long_random_secret

# Shared secret for service-to-service calls (this service's own /notifications/broadcast
# route, and outgoing calls to auth-service's internal student-lookup route). MUST match
# the INTERNAL_SERVICE_SECRET used by every other service.
INTERNAL_SERVICE_SECRET=replace_with_a_long_random_secret_2

# Used to resolve a student's email for targeted (not broadcast) notifications
AUTH_SERVICE_URL=http://localhost:5001

# Email (Nodemailer - same pattern as auth-service)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# CORS for the Socket.io server specifically (separate from Express's cors())
FRONTEND_ORIGIN=http://localhost:5173
