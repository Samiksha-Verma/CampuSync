# Server
PORT=5004

# MongoDB (separate database from the other services)
MONGO_URI=mongodb://127.0.0.1:27017/campusync_opportunities

# JWT - MUST match the JWT_SECRET used by every other service and the gateway
JWT_SECRET=replace_with_a_long_random_secret

# Used to notify students in real time on postings and application status changes
NOTIFICATION_SERVICE_URL=http://localhost:5009
INTERNAL_SERVICE_SECRET=replace_with_a_long_random_secret_2
