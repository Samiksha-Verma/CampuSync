# Server
PORT=5002

# MongoDB (separate database from auth-service)
MONGO_URI=mongodb://127.0.0.1:27017/campusync_users

# JWT - MUST match auth-service's JWT_SECRET exactly, since this service verifies
# tokens that were issued by auth-service, not tokens it issues itself.
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary (avatar image uploads)
# Sign up free at https://cloudinary.com/users/register/free, then find these
# three values on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
