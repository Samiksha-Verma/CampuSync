# Server
PORT=5001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/campusync_auth

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_STUDENT_EXPIRES_IN=1d
JWT_STAFF_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_MIN=5

# Shared secret for service-to-service calls (this service's internal student-lookup
# route, called by notification-service). MUST match INTERNAL_SERVICE_SECRET used by
# every other service.
INTERNAL_SERVICE_SECRET=replace_with_a_long_random_secret_2

# Email (Nodemailer - example uses Gmail SMTP with an App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# One-time Admin seed (used only by `npm run seed:admin`)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@campusync.edu
ADMIN_PASSWORD=change_this_password
