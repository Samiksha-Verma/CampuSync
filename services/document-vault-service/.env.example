# Server
PORT=5006

# MongoDB (separate database from the other services)
MONGO_URI=mongodb://127.0.0.1:27017/campusync_vault

# JWT - MUST match the JWT_SECRET used by every other service and the gateway
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary (document storage - uploaded as "authenticated" resources, not public,
# since these can include ID documents. See README for why.)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
