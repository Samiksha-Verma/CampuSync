# Server
PORT=5007

# JWT - MUST match the JWT_SECRET used by every other service and the gateway
JWT_SECRET=replace_with_a_long_random_secret

# Groq API - get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Downstream services this one calls on the student's own behalf (forwards their
# Authorization header - no internal-secret machinery needed, see README)
DOCUMENT_VAULT_SERVICE_URL=http://localhost:5006
USER_SERVICE_URL=http://localhost:5002
OPPORTUNITIES_SERVICE_URL=http://localhost:5004

# No MONGO_URI - this service is stateless by design (see README, Phase 6)
